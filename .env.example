# Firebase Web App config (client config; never put service-account keys here).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Local Gemini proxy, for example http://192.168.2.21:3001 (PC LAN IP).
# Use HTTPS when deploying outside your development LAN.
EXPO_PUBLIC_AI_PROXY_URL=
