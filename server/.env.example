# Keep these server-only. Never use EXPO_PUBLIC_ for the Gemini key.
GEMINI_API_KEY=
# Set a currently available Gemini model that supports generateContent JSON output.
GEMINI_MODEL=gemini-2.5-flash
# Firebase Web API key of the same project as the app, to validate Firebase ID tokens.
FIREBASE_WEB_API_KEY=
# 127.0.0.1 by default; set 0.0.0.0 only for testing from your own LAN.
HOST=127.0.0.1
PORT=3001
